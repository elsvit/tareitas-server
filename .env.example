# Copy relevant lines to /var/www/tareitas-server/.env on Hetzner

# Production: object storage is required (server exits on startup if S3 is missing).
# NODE_ENV=production

# RevenueCat → Project Settings → Integrations → Webhooks
# URL: https://api.tareitas.net/api/webhooks/revenuecat
# Authorization header: use the exact same value here.
# Example: REVENUECAT_WEBHOOK_AUTHORIZATION=Bearer tareitas-rc-wh-CHANGE_ME
REVENUECAT_WEBHOOK_AUTHORIZATION=

# Hetzner Object Storage (S3-compatible). When set, uploads use presigned PUT/GET.
# Bucket layout: photos/{familyId}/{uuid}.jpg, voice/{familyId}/{uuid}.m4a
S3_ENDPOINT=https://hel1.your-objectstorage.com
S3_BUCKET=tareitas-media
S3_REGION=hel1
# Either naming style works:
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# Optional public CDN base (skips presigned GET when set)
# MEDIA_CDN_BASE_URL=https://cdn.tareitas.net
# S3_PRESIGN_EXPIRY_SECONDS=900
