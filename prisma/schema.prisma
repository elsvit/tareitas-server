generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String?  @unique(map: "users_username_unique") @db.VarChar(50)
  email        String?  @unique(map: "users_email_unique") @db.VarChar(255)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  childProfile  ChildProfile?
  familyMembers FamilyMember[]

  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsReceived Invitation[] @relation("InvitationInvitedUser")

  parentProfile ParentProfile?
  refreshTokens RefreshToken[]

  tasksAssigned Task[] @relation("TaskAssignedTo")
  tasksCreated  Task[] @relation("TaskCreatedBy")

  rewardsCreated      Reward[]           @relation("RewardCreatedBy")
  rewardRedemptions   RewardRedemption[] @relation("RewardRedemptionChild")
  notifications       Notification[]

  @@map("users")
}

model Family {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  members     FamilyMember[]
  invitations Invitation[]
  tasks       Task[]
  rewards            Reward[]
  rewardRedemptions  RewardRedemption[]
  notifications    Notification[]

  @@map("families")
}

model FamilyMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @db.VarChar(20)
  familyRole String?  @map("family_role") @db.VarChar(30)
  isOwner    Boolean  @default(false) @map("is_owner")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_family_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_user_fk")

  @@unique([familyId, userId], map: "family_members_unique")
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model ParentProfile {
  userId String  @id @map("user_id") @db.Uuid
  name   String  @db.VarChar(100)
  color  String? @db.VarChar(50)
  avatar String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "parent_profiles_user_fk")

  @@map("parent_profiles")
}

model ChildProfile {
  userId   String    @id @map("user_id") @db.Uuid
  name     String    @db.VarChar(100)
  birthday DateTime? @db.Date
  color    String?   @db.VarChar(50)
  avatar   String?
  reward   Decimal   @default(0) @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "child_profiles_user_fk")

  @@map("child_profiles")
}

model Invitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  familyId String @map("family_id") @db.Uuid

  invitedUserId   String? @map("invited_user_id") @db.Uuid
  invitedEmail    String? @map("invited_email") @db.VarChar(255)
  invitedUsername String? @map("invited_username") @db.VarChar(50)

  invitedByUserId String @map("invited_by_user_id") @db.Uuid

  role       String  @db.VarChar(20)
  familyRole String? @map("family_role") @db.VarChar(30)

  token String @unique

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  invitedByUser User @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  invitedUser User? @relation("InvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([invitedEmail])
  @@index([invitedUsername])
  @@index([invitedUserId])
  @@map("invitations")
}

model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique

  userId String @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

model Task {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId    String  @map("family_id") @db.Uuid
  title       String  @db.VarChar(200)
  description String?

  assignedToUserId String @map("assigned_to_user_id") @db.Uuid
  createdByUserId  String @map("created_by_user_id") @db.Uuid

  points Decimal @default(0) @db.Decimal(10, 2)
  status String  @default("pending") @db.VarChar(20)

  dueDate     DateTime? @map("due_date") @db.Date
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_family_fk")
  assignedTo User   @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_assigned_to_fk")
  createdBy  User   @relation("TaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_created_by_fk")

  @@index([familyId])
  @@index([assignedToUserId])
  @@index([status])
  @@map("tasks")
}

model Reward {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId    String  @map("family_id") @db.Uuid
  title       String  @db.VarChar(200)
  description String?
  cost        Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true) @map("is_active")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rewards_family_fk")
  createdBy   User               @relation("RewardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rewards_created_by_fk")
  redemptions RewardRedemption[]

  @@index([familyId])
  @@map("rewards")
}

model RewardRedemption {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  rewardId String @map("reward_id") @db.Uuid

  childUserId String @map("child_user_id") @db.Uuid
  cost        Decimal @db.Decimal(10, 2)
  status      String  @default("pending") @db.VarChar(20)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_redemptions_family_fk")
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_redemptions_reward_fk")
  child  User   @relation("RewardRedemptionChild", fields: [childUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_redemptions_child_fk")

  @@index([familyId])
  @@index([childUserId])
  @@index([status])
  @@map("reward_redemptions")
}

model Notification {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  familyId String? @map("family_id") @db.Uuid

  type  String  @db.VarChar(50)
  title String  @db.VarChar(200)
  body  String?
  data  Json?

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_fk")
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_family_fk")

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}
