generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String?  @unique(map: "users_username_unique") @db.VarChar(50)
  email        String?  @unique(map: "users_email_unique") @db.VarChar(255)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  childProfile  ChildProfile?
  familyMembers FamilyMember[]

  parentProfile ParentProfile?
  refreshTokens RefreshToken[]

  taskAssignmentsAsChild  TaskAssignment[] @relation("TaskAssignmentChild")
  taskAssignmentsCreated  TaskAssignment[] @relation("TaskAssignmentCreatedBy")

  rewardsCreated      Reward[]           @relation("RewardCreatedBy")
  rewardRedemptions   RewardRedemption[] @relation("RewardRedemptionChild")
  notifications       Notification[]

  @@map("users")
}

model Family {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  taskBaseRevision            Int @default(0) @map("task_base_revision")
  rewardBaseRevision        Int @default(0) @map("reward_base_revision")
  bundledTaskCatalogVersion   Int @default(0) @map("bundled_task_catalog_version")
  bundledRewardCatalogVersion Int @default(0) @map("bundled_reward_catalog_version")
  earnedRewardPeriods         Json @default("[]") @map("earned_reward_periods")

  members     FamilyMember[]
  taskAssignments TaskAssignment[]
  tasks       Task[]
  rewards            Reward[]
  rewardRedemptions  RewardRedemption[]
  notifications    Notification[]
  taskBaseItems   TaskBaseItem[]
  rewardBaseItems RewardBaseItem[]

  @@map("families")
}

model FamilyMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @db.VarChar(20)
  familyRole String?  @map("family_role") @db.VarChar(30)
  isOwner    Boolean  @default(false) @map("is_owner")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_family_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_user_fk")

  @@unique([familyId, userId], map: "family_members_unique")
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model ParentProfile {
  userId String  @id @map("user_id") @db.Uuid
  name   String  @db.VarChar(100)
  color  String? @db.VarChar(50)
  avatar String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "parent_profiles_user_fk")

  @@map("parent_profiles")
}

model ChildProfile {
  userId   String    @id @map("user_id") @db.Uuid
  name     String    @db.VarChar(100)
  birthday DateTime? @db.Date
  color    String?   @db.VarChar(50)
  avatar   String?
  reward   Decimal   @default(0) @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "child_profiles_user_fk")

  @@map("child_profiles")
}

model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique

  userId String @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}

model TaskAssignment {
  id       String @id @db.Uuid
  familyId String @map("family_id") @db.Uuid
  childId  String @map("child_id") @db.Uuid

  title       String  @db.VarChar(200)
  description String?
  reward      Decimal @default(0) @db.Decimal(10, 2)
  picture     String?
  color       String? @db.VarChar(50)

  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  time      String    @default("00:00") @db.VarChar(5)

  isHabit Boolean @default(false) @map("is_habit")

  repeat Json?

  newTaskBonus    Decimal? @map("new_task_bonus") @db.Decimal(10, 2)
  newTaskDuration Int?     @map("new_task_duration")

  subtasks Json?
  changes  Json     @default("{}")

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family    Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_assignments_family_fk")
  child     User   @relation("TaskAssignmentChild", fields: [childId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_assignments_child_fk")
  createdBy User   @relation("TaskAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_assignments_created_by_fk")
  tasks     Task[]

  @@index([familyId])
  @@index([childId])
  @@map("task_assignments")
}

model Task {
  id           String @id @db.Uuid
  familyId     String @map("family_id") @db.Uuid
  assignmentId String @map("assignment_id") @db.Uuid

  date   DateTime @db.Date
  status String   @default("pending") @db.VarChar(20)

  completedSubtasks Json @default("[]") @map("completed_subtasks")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family     Family         @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_family_fk")
  assignment TaskAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "tasks_assignment_fk")

  @@unique([assignmentId, date], map: "tasks_assignment_id_date_unique")
  @@index([familyId])
  @@index([assignmentId])
  @@index([date])
  @@index([status])
  @@map("tasks")
}

model Reward {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId    String  @map("family_id") @db.Uuid
  title       String  @db.VarChar(200)
  description String?
  cost        Decimal @db.Decimal(10, 2)
  isActive    Boolean @default(true) @map("is_active")
  childUserIds String[] @default([]) @map("child_user_ids") @db.Uuid

  createdByUserId String @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family      Family             @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rewards_family_fk")
  createdBy   User               @relation("RewardCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "rewards_created_by_fk")
  redemptions RewardRedemption[]

  @@index([familyId])
  @@map("rewards")
}

model RewardRedemption {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId String @map("family_id") @db.Uuid
  rewardId String @map("reward_id") @db.Uuid

  childUserId String @map("child_user_id") @db.Uuid
  cost        Decimal @db.Decimal(10, 2)
  status      String  @default("pending") @db.VarChar(20)

  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  approvedAt DateTime? @map("approved_at") @db.Timestamptz(6)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_redemptions_family_fk")
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_redemptions_reward_fk")
  child  User   @relation("RewardRedemptionChild", fields: [childUserId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_redemptions_child_fk")

  @@index([familyId])
  @@index([childUserId])
  @@index([status])
  @@map("reward_redemptions")
}

model Notification {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  familyId String? @map("family_id") @db.Uuid

  type  String  @db.VarChar(50)
  title String  @db.VarChar(200)
  body  String?
  data  Json?

  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_user_fk")
  family Family? @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "notifications_family_fk")

  @@index([userId])
  @@index([userId, readAt])
  @@map("notifications")
}

model TaskBaseItem {
  id       String @db.VarChar(100)
  familyId String @map("family_id") @db.Uuid

  name        String   @db.VarChar(200)
  description String?
  reward      Decimal? @db.Decimal(10, 2)
  picture     String?
  time        String?  @db.VarChar(5)
  color       String?  @db.VarChar(50)
  subtasks    Json?
  isHidden    Boolean  @default(false) @map("is_hidden")
  source      String   @default("custom") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "task_base_items_family_fk")

  @@id([familyId, id])
  @@index([familyId])
  @@map("task_base_items")
}

model RewardBaseItem {
  id       String @db.VarChar(100)
  familyId String @map("family_id") @db.Uuid

  title    String  @db.VarChar(200)
  reward   Decimal @db.Decimal(10, 2)
  picture  String?
  isHidden Boolean @default(false) @map("is_hidden")
  source   String  @default("custom") @db.VarChar(20)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "reward_base_items_family_fk")

  @@id([familyId, id])
  @@index([familyId])
  @@map("reward_base_items")
}
