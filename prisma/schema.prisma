generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String?  @unique(map: "users_username_unique") @db.VarChar(50)
  email        String?  @unique(map: "users_email_unique") @db.VarChar(255)
  passwordHash String?  @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  childProfile  ChildProfile?
  familyMembers FamilyMember[]

  invitationsSent     Invitation[] @relation("InvitationInvitedBy")
  invitationsReceived Invitation[] @relation("InvitationInvitedUser")

  parentProfile ParentProfile?
  refreshTokens RefreshToken[]

  @@map("users")
}

model Family {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  members     FamilyMember[]
  invitations Invitation[]

  @@map("families")
}

model FamilyMember {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familyId   String   @map("family_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  role       String   @db.VarChar(20)
  familyRole String?  @map("family_role") @db.VarChar(30)
  isOwner    Boolean  @default(false) @map("is_owner")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_family_fk")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "family_members_user_fk")

  @@unique([familyId, userId], map: "family_members_unique")
  @@index([familyId])
  @@index([userId])
  @@map("family_members")
}

model ParentProfile {
  userId String  @id @map("user_id") @db.Uuid
  name   String  @db.VarChar(100)
  color  String? @db.VarChar(50)
  avatar String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "parent_profiles_user_fk")

  @@map("parent_profiles")
}

model ChildProfile {
  userId   String    @id @map("user_id") @db.Uuid
  name     String    @db.VarChar(100)
  birthday DateTime? @db.Date
  color    String?   @db.VarChar(50)
  avatar   String?
  reward   Decimal   @default(0) @db.Decimal(10, 2)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "child_profiles_user_fk")

  @@map("child_profiles")
}

model Invitation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  familyId String @map("family_id") @db.Uuid

  invitedUserId   String? @map("invited_user_id") @db.Uuid
  invitedEmail    String? @map("invited_email") @db.VarChar(255)
  invitedUsername String? @map("invited_username") @db.VarChar(50)

  invitedByUserId String @map("invited_by_user_id") @db.Uuid

  role       String  @db.VarChar(20)
  familyRole String? @map("family_role") @db.VarChar(30)

  token String @unique

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz(6)
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  invitedByUser User @relation("InvitationInvitedBy", fields: [invitedByUserId], references: [id], onDelete: Cascade)

  invitedUser User? @relation("InvitationInvitedUser", fields: [invitedUserId], references: [id], onDelete: SetNull)

  @@index([familyId])
  @@index([invitedEmail])
  @@index([invitedUsername])
  @@index([invitedUserId])
  @@map("invitations")
}

model RefreshToken {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash String @unique

  userId String @map("user_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("refresh_tokens")
}
